# Copy this file to .env and fill in your own values.
# NEVER commit .env — it is in .gitignore.
# Get these from https://www.etsy.com/developers/your-apps
ETSY_API_KEY=your_keystring_here
ETSY_SHARED_SECRET=your_shared_secret_here
# Optional: your shop name, used only if Etsy's /users/me endpoint
# returns 403 for your app (the app then looks the shop up by name).
# ETSY_SHOP_NAME=
